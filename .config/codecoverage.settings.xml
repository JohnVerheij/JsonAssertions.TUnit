<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft.Testing.Platform code-coverage extension settings (MTP schema).

  See SnapshotAssertions.TUnit's equivalent file for the schema rationale. The flat
  Configuration/CodeCoverage root is what MTP's coverage-settings flag accepts; the
  ModulePaths/Include directives below are required to ensure Linux runners actually
  instrument the production assemblies (without them, MTP emits an empty 178-byte
  cobertura stub).
-->
<Configuration>
  <CodeCoverage>
    <!-- Only instrument the production assembly. Test DLLs and third-party packages are
         out of scope for coverage accounting. The single JsonAssertions.TUnit assembly
         carries both the JsonAssertions core namespace and the JsonAssertions.TUnit
         adapter namespace. -->
    <ModulePaths>
      <Include>
        <ModulePath>.*JsonAssertions\.TUnit\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- Exclude only source-generated code: files emitted under obj/, and the generators' output
         (TUnit's assertion classes and extensions, System.Text.Json's context), whose hint names end
         in .g.cs. Hand-written code is measured in full, including async state machines and lambdas
         (CompilerGeneratedAttribute is deliberately not excluded) and the [GenerateAssertion]
         source methods, which the generated assertion classes call. -->
    <Sources>
      <Exclude>
        <Source>.*[/\\]obj[/\\].*</Source>
        <Source>.*\.g\.cs$</Source>
      </Exclude>
    </Sources>
    <!-- Exclude code marked as generated, and nothing else: an opt-out attribute would let later code hide from the
         report without anyone noticing. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <!-- MTP default is false (VSTest default was true). Explicit for clarity. -->
    <IncludeTestAssembly>false</IncludeTestAssembly>
  </CodeCoverage>
</Configuration>
